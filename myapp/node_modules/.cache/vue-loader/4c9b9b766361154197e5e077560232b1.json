 <button @click=\"zoomOut\">缩小</button>\r\n              <button @click=\"resetView\">重置视图</button>\r\n            </div>\r\n          </div>\r\n          <div class=\"control-panel\">\r\n            <div class=\"season-filter\">\r\n              <button :class=\"{ active: selectedSeason === '春' }\" @click=\"selectSeason('春')\">东宫苍龙</button>\r\n              <button :class=\"{ active: selectedSeason === '夏' }\" @click=\"selectSeason('夏')\">南宫朱雀</button>\r\n              <button :class=\"{ active: selectedSeason === '秋' }\" @click=\"selectSeason('秋')\">西宫白虎</button>\r\n              <button :class=\"{ active: selectedSeason === '冬' }\" @click=\"selectSeason('冬')\">北宫玄武</button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"chart-box\">\r\n        <h3>天文仪器发展时间轴</h3>\r\n        <v-chart class=\"chart\" :option=\"timelineOptions\" autoresize />\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"constellation-table\">\r\n      <h3>星官详细信息</h3>\r\n      <table>\r\n        <thead>\r\n          <tr>\r\n            <th>星官名称</th>\r\n            <th>所属宿</th>\r\n            <th>星数</th>\r\n            <th>对应地理</th>\r\n            <th>历史记载</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"item in constellationList\" :key=\"item.id\">\r\n            <td>{{ item.name }}</td>\r\n            <td>{{ item.mansion }}</td>\r\n            <td>{{ item.starCount }}</td>\r\n            <td>{{ item.geography }}</td>\r\n            <td>\r\n              <div class=\"history-text\">{{ item.history }}</div>\r\n            </td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted, onUnmounted, nextTick } from 'vue';\r\nimport { use } from 'echarts/core';\r\nimport { CanvasRenderer } from 'echarts/renderers';\r\nimport { PieChart, LineChart } from 'echarts/charts';\r\nimport { GridComponent, TooltipComponent, TitleComponent, LegendComponent, TimelineComponent } from 'echarts/components';\r\nimport VChart from 'vue-echarts';\r\nimport * as d3 from 'd3';\r\n\r\nuse([\r\n  CanvasRenderer,\r\n  PieChart,\r\n  LineChart,\r\n  GridComponent,\r\n  TooltipComponent,\r\n  TitleComponent,\r\n  LegendComponent,\r\n  TimelineComponent\r\n]);\r\n\r\nexport default {\r\n  name: 'StarSystemVisualization',\r\n  components: { VChart },\r\n  setup() {\r\n    // 星图相关数据\r\n    const selectedConstellation = ref(null);\r\n    const selectedSeason = ref('春');\r\n    const starMapCanvas = ref(null);\r\n    let zoom = null;\r\n    let svg = null;\r\n    let g = null;\r\n\r\n    // 星官数据\r\n    const constellationList = ref([\r\n      {\r\n        id: 1,\r\n        name: '角宿',\r\n        mansion: '东宫苍龙',\r\n        starCount: 12,\r\n        geography: '齐地',\r\n        history: '《史记·天官书》：角，天门，郊祀前望。'\r\n      },\r\n      {\r\n        id: 2,\r\n        name: '亢宿',\r\n        mansion: '东宫苍龙',\r\n        starCount: 4,\r\n        geography: '宋地',\r\n        history: '《史记·天官书》：亢，阙庭，人主奉邑。'\r\n      },\r\n      // ... 其他星官数据\r\n    ]);\r\n\r\n    // 时间轴配置\r\n    const timelineOptions = ref({\r\n      baseOption: {\r\n        timeline: {\r\n          axisType: 'category',\r\n          autoPlay: true,\r\n          playInterval: 3000,\r\n          data: ['商周', '春秋战国', '秦汉', '魏晋南北朝', '隋唐', '宋元', '明清'],\r\n          label: {\r\n            color: '#fff'\r\n          }\r\n        },\r\n        title: {\r\n          text: '中国古代天文仪器发展史',\r\n          textStyle: {\r\n            color: '#fff',\r\n            fontSize: 16\r\n          }\r\n        },\r\n        tooltip: {\r\n          trigger: 'axis',\r\n          backgroundColor: 'rgba(0,0,0,0.7)',\r\n          borderColor: 'rgba(255,255,255,0.5)',\r\n          textStyle: {\r\n            color: '#fff'\r\n          }\r\n        },\r\n        xAxis: {\r\n          type: 'category',\r\n          data: ['圭表', '浑天仪', '简仪', '漏刻', '浑象', '圭表'],\r\n          axisLabel: { \r\n            color: '#fff',\r\n            fontSize: 14\r\n          }\r\n        },\r\n        yAxis: {\r\n          type: 'value',\r\n          axisLabel: { \r\n            color: '#fff',\r\n            fontSize: 14\r\n          }\r\n        },\r\n        series: [{\r\n          type: 'line',\r\n          data: [10, 25, 40, 55, 70, 85],\r\n          lineStyle: {\r\n            width: 5,\r\n            color: '#00b8d4'\r\n          },\r\n          symbolSize: 12,\r\n          areaStyle: {\r\n            color: {\r\n              type: 'linear',\r\n              x: 0,\r\n              y: 0,\r\n              x2: 0,\r\n              y2: 1,\r\n              colorStops: [{\r\n                offset: 0,\r\n                color: 'rgba(0,184,212,0.3)'\r\n              }, {\r\n                offset: 1,\r\n                color: 'rgba(0,184,212,0.05)'\r\n              }]\r\n            }\r\n          }\r\n        }]\r\n      },\r\n      options: [\r\n        {\r\n          title: { text: '商周时期' },\r\n          series: [{ data: [10, 15, 20, 25, 30, 35] }]\r\n        },\r\n        {\r\n          title: { text: '春秋战国时期' },\r\n          series: [{ data: [15, 25, 35, 45, 55, 65] }]\r\n        },\r\n        {\r\n          title: { text: '秦汉时期' },\r\n          series: [{ data: [20, 35, 50, 65, 80, 95] }]\r\n        },\r\n        {\r\n          title: { text: '魏晋南北朝时期' },\r\n          series: [{ data: [25, 40, 55, 70, 85, 100] }]\r\n        },\r\n        {\r\n          title: { text: '隋唐时期' },\r\n          series: [{ data: [30, 45, 60, 75, 90, 105] }]\r\n        },\r\n        {\r\n          title: { text: '宋元时期' },\r\n          series: [{ data: [35, 50, 65, 80, 95, 110] }]\r\n        },\r\n        {\r\n          title: { text: '明清时期' },\r\n          series: [{ data: [40, 55, 70, 85, 100, 115] }]\r\n        }\r\n      ]\r\n    });\r\n\r\n    // 初始化星图\r\n    const initStarMap = () => {\r\n      if (!starMapCanvas.value) return;\r\n\r\n      const container = starMapCanvas.value;\r\n      const width = container.clientWidth;\r\n      const height = container.clientHeight;\r\n\r\n      // 清除现有内容\r\n      d3.select(container).selectAll(\"*\").remove();\r\n\r\n      // 创建SVG容器\r\n      svg = d3.select(container)\r\n        .append(\"svg\")\r\n        .attr(\"width\", \"100%\")\r\n        .attr(\"height\", \"100%\")\r\n        .attr(\"viewBox\", `0 0 ${width} ${height}`)\r\n        .style(\"background-color\", \"rgba(0, 0, 0, 0.5)\");\r\n\r\n      // 添加缩放功能\r\n      zoom = d3.zoom()\r\n        .scaleExtent([0.5, 5])\r\n        .on(\"zoom\", (event) => {\r\n          g.attr(\"transform\", event.transform);\r\n        });\r\n      \r\n      svg.call(zoom);\r\n\r\n      // 创建主绘图组\r\n      g = svg.append(\"g\");\r\n\r\n      // 定义四象方位的中心点和半径\r\n      const centerX = width / 2;\r\n      const centerY = height / 2;\r\n      const radius = Math.min(width, height) * 0.35;\r\n\r\n      // 定义二十八宿数据\r\n      const constellations = {\r\n        \"春\": [ // 东宫苍龙七宿\r\n          { name: \"角宿\", stars: 12, angle: 0 },\r\n          { name: \"亢宿\", stars: 4, angle: 15 },\r\n          { name: \"氐宿\", stars: 4, angle: 30 },\r\n          { name: \"房宿\", stars: 4, angle: 45 },\r\n          { name: \"心宿\", stars: 3, angle: 60 },\r\n          { name: \"尾宿\", stars: 9, angle: 75 },\r\n          { name: \"箕宿\", stars: 4, angle: 90 }\r\n        ],\r\n        \"夏\": [ // 南宫朱雀七宿\r\n          { name: \"井宿\", stars: 8, angle: 90 },\r\n          { name: \"鬼宿\", stars: 5, angle: 105 },\r\n          { name: \"柳宿\", stars: 8, angle: 120 },\r\n          { name: \"星宿\", stars: 7, angle: 135 },\r\n          { name: \"张宿\", stars: 6, angle: 150 },\r\n          { name: \"翼宿\", stars: 22, angle: 165 },\r\n          { name: \"轸宿\", stars: 4, angle: 180 }\r\n        ],\r\n        \"秋\": [ // 西宫白虎七宿\r\n          { name: \"奎宿\", stars: 16, angle: 180 },\r\n          { name: \"娄宿\", stars: 3, angle: 195 },\r\n          { name: \"胃宿\", stars: 3, angle: 210 },\r\n          { name: \"昴宿\", stars: 7, angle: 225 },\r\n          { name: \"毕宿\", stars: 8, angle: 240 },\r\n          { name: \"觜宿\", stars: 3, angle: 255 },\r\n          { name: \"参宿\", stars: 7, angle: 270 }\r\n        ],\r\n        \"冬\": [ // 北宫玄武七宿\r\n          { name: \"斗宿\", stars: 6, angle: 270 },\r\n          { name: \"牛宿\", stars: 6, angle: 285 },\r\n          { name: \"女宿\", stars: 4, angle: 300 },\r\n          { name: \"虚宿\", stars: 2, angle: 315 },\r\n          { name: \"危宿\", stars: 3, angle: 330 },\r\n          { name: \"室宿\", stars: 2, angle: 345 },\r\n          { name: \"壁宿\", stars: 2, angle: 360 }\r\n        ]\r\n      };\r\n\r\n      // 过滤当前季节的星宿\r\n      const currentConstellations = constellations[selectedSeason.value];\r\n\r\n      // 计算星宿位置\r\n      currentConstellations.forEach((constellation, index) => {\r\n        const angle = (constellation.angle * Math.PI) / 180;\r\n        constellation.x = centerX + radius * Math.cos(angle);\r\n        constellation.y = centerY + radius * Math.sin(angle);\r\n      });\r\n\r\n      // 绘制连线\r\n      g.selectAll(\"path\")\r\n        .data(currentConstellations)\r\n        .enter()\r\n        .append(\"path\")\r\n        .attr(\"d\", (d, i) => {\r\n          if (i === currentConstellations.length - 1) return \"\";\r\n          const next = currentConstellations[(i + 1) % currentConstellations.length];\r\n          return `M ${d.x} ${d.y} Q ${centerX} ${centerY} ${next.x} ${next.y}`;\r\n        })\r\n        .attr(\"stroke\", \"#4a90e2\")\r\n        .attr(\"stroke-width\", 2)\r\n        .attr(\"fill\", \"none\")\r\n        .attr(\"stroke-opacity\", 0.6);\r\n\r\n      // 绘制星点\r\n      g.selectAll(\"circle\")\r\n        .data(currentConstellations)\r\n        .enter()\r\n        .append(\"circle\")\r\n        .attr(\"cx\", d => d.x)\r\n        .attr(\"cy\", d => d.y)\r\n        .attr(\"r\", d => Math.min(5 + d.stars / 3, 12))\r\n        .attr(\"fill\", \"#fff\")\r\n        .attr(\"stroke\", \"#4a90e2\")\r\n        .attr(\"stroke-width\", 2)\r\n        .on(\"mouseover\", function(event, d) {\r\n          d3.select(this)\r\n            .attr(\"r\", d => Math.min(8 + d.stars / 3, 15))\r\n            .attr(\"fill\", \"#4a90e2\");\r\n          \r\n          selectedConstellation.value = {\r\n            name: d.name,\r\n            description: `${d.name}：${d.stars}颗星，${getConstellationDescription(d.name)}`\r\n          };\r\n        })\r\n        .on(\"mouseout\", function(event, d) {\r\n          d3.select(this)\r\n            .attr(\"r\", d => Math.min(5 + d.stars / 3, 12))\r\n            .attr(\"fill\", \"#fff\");\r\n          \r\n          selectedConstellation.value = null;\r\n        });\r\n\r\n      // 添加文字标签\r\n      g.selectAll(\"text\")\r\n        .data(currentConstellations)\r\n        .enter()\r\n        .append(\"text\")\r\n        .attr(\"x\", d => d.x + (d.x > centerX ? 15 : -15))\r\n        .attr(\"y\", d => d.y)\r\n        .attr(\"text-anchor\", d => d.x > centerX ? \"start\" : \"end\")\r\n        .attr(\"alignment-baseline\", \"middle\")\r\n        .text(d => d.name)\r\n        .attr(\"fill\", \"#fff\")\r\n        .attr(\"font-size\", \"14px\");\r\n\r\n      // 添加四象名称\r\n      const directions = [\r\n        { name: \"东宫苍龙\", angle: 0 },\r\n        { name: \"南宫朱雀\", angle: 90 },\r\n        { name: \"西宫白虎\", angle: 180 },\r\n        { name: \"北宫玄武\", angle: 270 }\r\n      ];\r\n\r\n      g.selectAll(\".direction-text\")\r\n        .data(directions)\r\n        .enter()\r\n        .append(\"text\")\r\n        .attr(\"class\", \"direction-text\")\r\n        .attr(\"x\", d => centerX + (radius + 50) * Math.cos((d.angle * Math.PI) / 180))\r\n        .attr(\"y\", d => centerY + (radius + 50) * Math.sin((d.angle * Math.PI) / 180))\r\n        .attr(\"text-anchor\", \"middle\")\r\n        .attr(\"alignment-baseline\", \"middle\")\r\n        .text(d => d.name)\r\n        .attr(\"fill\", \"#4a90e2\")\r\n        .attr(\"font-size\", \"16px\")\r\n        .attr(\"font-weight\", \"bold\");\r\n    };\r\n\r\n    // 添加星宿描述函数\r\n    const getConstellationDescription = (name) => {\r\n      const descriptions = {\r\n        \"角宿\": \"象征龙角，主管农业和天气\",\r\n        \"亢宿\": \"象征龙颈，主管疾病和灾害\",\r\n        \"氐宿\": \"象征龙胸，主管建筑和工程\",\r\n        \"房宿\": \"象征龙腹，主管仓储和财富\",\r\n        \"心宿\": \"象征龙心，主管帝王和朝廷\",\r\n        \"尾宿\": \"象征龙尾，主管军事和战争\",\r\n        \"箕宿\": \"象征龙尾末端，主管风雨和收获\",\r\n        \"井宿\": \"象征朱雀喙，主管水利和灌溉\",\r\n        \"鬼宿\": \"象征朱雀颈，主管阴阳和鬼神\",\r\n        \"柳宿\": \"象征朱雀眼，主管文教和礼仪\",\r\n        \"星宿\": \"象征朱雀心，主管天文和历法\",\r\n        \"张宿\": \"象征朱雀翼，主管音乐和艺术\",\r\n        \"翼宿\": \"象征朱雀翅，主管礼制和仪式\",\r\n        \"轸宿\": \"象征朱雀尾，主管交通和道路\",\r\n        \"奎宿\": \"象征白虎头，主管城池和建设\",\r\n        \"娄宿\": \"象征白虎颈，主管畜牧和牲畜\",\r\n        \"胃宿\": \"象征白虎腹，主管饮食和仓储\",\r\n        \"昴宿\": \"象征白虎肩，主管军队和将帅\",\r\n        \"毕宿\": \"象征白虎腰，主管狩猎和武备\",\r\n        \"觜宿\": \"象征白虎口，主管言论和政令\",\r\n        \"参宿\": \"象征白虎足，主管道路和行旅\",\r\n        \"斗宿\": \"象征玄武首，主管水运和航海\",\r\n        \"牛宿\": \"象征玄武颈，主管农牧和畜养\",\r\n        \"女宿\": \"象征玄武腹，主管婚姻和嫁娶\",\r\n        \"虚宿\": \"象征玄武尾，主管虚无和变化\",\r\n        \"危宿\": \"象征玄武胁，主管危难和灾祸\",\r\n        \"室宿\": \"象征玄武足，主管宫室和居处\",\r\n        \"壁宿\": \"象征玄武背，主管疆界和城防\"\r\n      };\r\n      return descriptions[name] || \"暂无描述\";\r\n    };\r\n\r\n    // 选择季节\r\n    const selectSeason = (season) => {\r\n      selectedSeason.value = season;\r\n      initStarMap();\r\n    };\r\n\r\n    // 缩放控制\r\n    const zoomIn = () => {\r\n      if (svg) {\r\n        const currentTransform = d3.zoomTransform(svg.node());\r\n        svg.transition()\r\n          .duration(300)\r\n          .call(zoom.scaleBy, 1.5);\r\n      }\r\n    };\r\n\r\n    const zoomOut = () => {\r\n      if (svg) {\r\n        const currentTransform = d3.zoomTransform(svg.node());\r\n        svg.transition()\r\n          .duration(300)\r\n          .call(zoom.scaleBy, 0.75);\r\n      }\r\n    };\r\n\r\n    const resetView = () => {\r\n      if (svg) {\r\n        const container = starMapCanvas.value;\r\n        const width = container.clientWidth;\r\n        const height = container.clientHeight;\r\n        const bbox = g.node().getBBox();\r\n        const hRatio = width / bbox.width;\r\n        const vRatio = height / bbox.height;\r\n        const scale = 0.85 * Math.min(hRatio, vRatio);\r\n        const translateX = (width - bbox.width * scale) / 2 - bbox.x * scale;\r\n        const translateY = (height - bbox.height * scale) / 2 - bbox.y * scale;\r\n\r\n        svg.transition()\r\n          .duration(500)\r\n          .call(zoom.transform, d3.zoomIdentity\r\n            .translate(translateX, translateY)\r\n            .scale(scale));\r\n      }\r\n    };\r\n\r\n    // 响应式调整\r\n    const handleResize = () => {\r\n      if (starMapCanvas.value) {\r\n        initStarMap();\r\n      }\r\n    };\r\n\r\n    onMounted(() => {\r\n      initStarMap();\r\n      window.addEventListener('resize', handleResize);\r\n    });\r\n\r\n    onUnmounted(() => {\r\n      window.removeEventListener('resize', handleResize);\r\n    });\r\n\r\n    return {\r\n      selectedConstellation,\r\n      selectedSeason,\r\n      constellationList,\r\n      timelineOptions,\r\n      starMapCanvas,\r\n      selectSeason,\r\n      zoomIn,\r\n      zoomOut,\r\n      resetView\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 保持原有样式不变 */\r\n.content {\r\n  padding: 20px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 20px;\r\n  color: #fff;\r\n  height: calc(97vh - 60px);\r\n  border: 1px solid #4a90e2;\r\n  border-radius: 12px;\r\n  margin: 15px 20px;\r\n  background: linear-gradient(to bottom, rgba(13, 15, 44, 0.95), rgba(13, 15, 44, 0.85));\r\n  box-shadow: 0 0 20px rgba(74, 144, 226, 0.3);\r\n}\r\n\r\n.status-cards {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, 1fr);\r\n  gap: 20px;\r\n}\r\n\r\n.status-card {\r\n  background: rgba(13, 15, 44, 0.7);\r\n  border-radius: 8px;\r\n  padding: 30px;\r\n  text-align: center;\r\n  border: 1px solid rgba(74, 144, 226, 0.6);\r\n  transition: all 0.3s ea